# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_ADS_CLIENT: Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# When configured, activates real Google H5 Games Ad Placement API (adBreak / adConfig) on Web.
VITE_GOOGLE_ADS_CLIENT=""

# VITE_ADMOB_REWARDED_ID & VITE_ADMOB_INTERSTITIAL_ID: Native Google AdMob Unit IDs for Android APK.
# In test mode (VITE_GOOGLE_ADS_TEST_MODE="true"), official Google AdMob Android test units are used automatically.
VITE_ADMOB_REWARDED_ID=""
VITE_ADMOB_INTERSTITIAL_ID=""

# VITE_GOOGLE_ADS_TEST_MODE: Set to "true" to enable Google test ads on Web & Android AdMob.
VITE_GOOGLE_ADS_TEST_MODE="true"

# VITE_CHECKOUT_API_URL: Optional backend checkout endpoint for Web real-money purchases.
# On Android APK builds, native Google Play Billing (window.VirajPlayBilling) is detected automatically.
VITE_CHECKOUT_API_URL=""


